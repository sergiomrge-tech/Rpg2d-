; Engine configuration file.
config_version=5

[application]

config/name="Crônicas de Aetheria — A Centelha"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.png"
run/max_fps=60

[autoload]

Util="*res://scripts/core/util.gd"
Sheets="*res://scripts/core/sheets.gd"
Data="*res://scripts/game/data.gd"
Sfx="*res://scripts/core/sfx.gd"
Music="*res://scripts/core/music.gd"
Story="*res://scripts/game/story.gd"
Game="*res://scripts/game/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[layer_names]

2d_physics/layer_1="mundo"
2d_physics/layer_2="jogador"
2d_physics/layer_3="inimigos"
2d_physics/layer_4="npcs"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.07, 0.05, 0.1, 1)

[input_devices]

pointing/emulate_mouse_from_touch=false

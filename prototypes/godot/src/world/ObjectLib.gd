class_name ObjectLib
extends RefCounted
## Object definitions (sprites generated by tools/art/objects.py).

static var defs := {}
static var tex_cache := {}
static var loaded := false

static func _load() -> void:
	if loaded:
		return
	loaded = true
	if FileAccess.file_exists("res://assets/obj/objects.json"):
		defs = JSON.parse_string(FileAccess.get_file_as_string("res://assets/obj/objects.json"))

static func get_def(type: String) -> Dictionary:
	_load()
	if defs.has(type):
		return defs[type]
	if type.begins_with("house"):
		var wt := int(type.substr(5))
		var cells := []
		for yy in range(-3, 1):
			for xx in wt:
				cells.append([xx, yy])
		return {"cells": cells}
	return {"cells": [[0, 0]]}

static func texture(type: String) -> Texture2D:
	_load()
	if tex_cache.has(type):
		return tex_cache[type]
	var p := "res://assets/obj/%s.png" % type
	var t: Texture2D = load(p) if ResourceLoader.exists(p) else null
	tex_cache[type] = t
	return t
